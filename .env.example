# Copy to .env. docker compose reads the ports, the invenio CLI and Celery read
# the INVENIO_* settings. The tests ignore this file.

# Folder of the instance, for its static files and an optional invenio.cfg;
# <venv>/var/instance by default.
# INVENIO_INSTANCE_PATH=/path/to/var/sonar

# Host ports of docker-compose.yml and docker-compose-extra.yml, the standard
# ones by default. Change them to run several projects side by side.
# CACHE_PORT=6379
# DB_PORT=5432
# MQ_PORT=5672
# MQ_ADMIN_PORT=15672
# OS_PORT=9200
# OS_TRANSPORT_PORT=9300
# FLOWER_PORT=5555
# DASHBOARDS_PORT=5601
# REDISINSIGHT_PORT=5540
# MAILPIT_SMTP_PORT=1025
# MAILPIT_PORT=8025
# GROBID_PORT=8070
# GROBID_ADMIN_PORT=8071

# Endpoints of the application, on the ports above.
INVENIO_CACHE_REDIS_URL=redis://localhost:${CACHE_PORT:-6379}/0
INVENIO_ACCOUNTS_SESSION_REDIS_URL=redis://localhost:${CACHE_PORT:-6379}/1
INVENIO_CELERY_RESULT_BACKEND=redis://localhost:${CACHE_PORT:-6379}/2
INVENIO_RATELIMIT_STORAGE_URI=redis://localhost:${CACHE_PORT:-6379}/3
INVENIO_BROKER_URL=amqp://guest:guest@localhost:${MQ_PORT:-5672}/
INVENIO_CELERY_BROKER_URL=amqp://guest:guest@localhost:${MQ_PORT:-5672}/
INVENIO_SEARCH_HOSTS=["localhost:${OS_PORT:-9200}"]
INVENIO_SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://sonar:sonar@localhost:${DB_PORT:-5432}/sonar
INVENIO_PDF_EXTRACTOR_GROBID_PORT=${GROBID_PORT:-8070}

# Development settings.
APP_ENV=development

# To read the mails in Mailpit instead of dropping them:
# INVENIO_MAIL_SUPPRESS_SEND=False
# INVENIO_MAIL_SERVER=localhost
# INVENIO_MAIL_PORT=${MAILPIT_SMTP_PORT:-1025}
